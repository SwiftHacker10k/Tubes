}

func ubahTransaksi() { //berdasarkan sumber pendapatan
	var input string
	var idx int
	fmt.Print("Masukkan Sumber Pendapatan yang ingin diubah: ")
	fmt.Scan(&input)

	idx = cariIndexTransaksi(input)
	if idx == -1 {
		fmt.Println("Data tidak ditemukan. Coba lagi.\n")
		ubahTransaksi()
		return
	}

	fmt.Println("Masukkan data baru")
	fmt.Print("Sumber Pendapatan : ")
	fmt.Scan(&dataT[idx].sumber)
	fmt.Print("Kategori : ")
	fmt.Scan(&dataT[idx].kategori)
	fmt.Print("Nominal : ")
	fmt.Scan(&dataT[idx].nominal)
	fmt.Print("Biaya Operasional : ")
	fmt.Scan(&dataT[idx].biayaOperasional)
	fmt.Print("Tanggal, Bulan : ")
	fmt.Scan(&dataT[idx].tanggal, &dataT[idx].bulan)

	fmt.Println("Data berhasil diubah.\n")
	daftarLayanan()

}
func hapusTransaksi() {
	var input string
	var idx, i int
	fmt.Print("Masukkan Sumber Pendapatan yang ingin dihapus: ")
	fmt.Scan(&input)

	idx = cariIndexTransaksi(input)
	if idx == -1 {
		fmt.Println("Data tidak ditemukan. Coba lagi.\n")
		hapusTransaksi() // rekursi untuk ulangi input
		return
	}

	for i = idx; i < dataTransaksi-1; i++ {
		dataT[i] = dataT[i+1]
	}
	dataTransaksi--
	fmt.Println("Transaksi berhasil dihapus.\n")
	daftarLayanan()

}

func cariIndexTransaksi(sumber string) int {
	var i int
	for i = 0; i < dataTransaksi; i++ {
		if dataT[i].sumber == sumber {
			return i
		}
	}
	return -1
}

